# Required: turns on the AI (Studio chat and the home page chat)
ANTHROPIC_API_KEY=
# Optional
AI_MODEL=claude-haiku-5-5
STUDIO_MODEL=
STUDIO_MODEL_REASONING=
STUDIO_PER_MINUTE=20
STUDIO_PER_DAY=300
STUDIO_DISABLED=
# Sites allowed to call /api/studio (comma-separated). localhost and kira-os*.vercel.app always work.
ALLOWED_ORIGINS=https://getkira.xyz,https://www.getkira.xyz
# Total calls per day for all visitors together (per server instance)
STUDIO_DAILY_CAP=3000

# Required: turns on the AI (Studio chat and the home page chat)
ANTHROPIC_API_KEY=
# Optional
AI_MODEL=claude-haiku-5-5
STUDIO_MODEL=
STUDIO_MODEL_REASONING=
STUDIO_PER_MINUTE=20
STUDIO_PER_DAY=300
STUDIO_DISABLED=
# Sites allowed to call /api/studio (comma-separated). localhost and kira-os*.vercel.app always work.
ALLOWED_ORIGINS=https://getkira.xyz,https://www.getkira.xyz
# Total calls per day for all visitors together (per server instance)
STUDIO_DAILY_CAP=3000

# --- Accounts ---
# Required: long random string (e.g. openssl rand -hex 32)
SESSION_SECRET=
# Required: Upstash Redis (or KV_REST_API_URL / KV_REST_API_TOKEN from the Vercel integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SITE_URL=https://getkira.xyz
# Sign in with X (developer.x.com → Web App, callback https://getkira.xyz/api/auth/x-callback)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Sign in with email (resend.com; verify the getkira.xyz domain there)
RESEND_API_KEY=
EMAIL_FROM=KIRA OS <login@getkira.xyz>
